# Пароль шифрования cookie сессии. Не короче 32 символов.
# Вне режима разработки приложение без него не стартует.
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-string

# Хранилище токенов на Vercel. Локально не нужно: без переменных используется память.
# NUXT_REDIS_KV_REST_API_URL=https://example.upstash.io
# NUXT_REDIS_KV_REST_API_TOKEN=

# Локальный Redis вместо Upstash.
# REDIS_URL=redis://127.0.0.1:6379

# Как доставлять уведомления: poll (по умолчанию), sse или off.
# NUXT_REALTIME=poll

# Песочница @itd-api/testing для посетителей без токена.
# NUXT_PUBLIC_SANDBOX=true

# Журнал вызовов SDK в панели «под капотом».
# NUXT_PUBLIC_INSPECTOR=true

# Свой базовый URL API, если нужен собственный прокси.
# NUXT_ITD_BASE_URL=https://xn--d1ah4a.com

# Прокси для локального запуска.
# NUXT_PROXY_URL=socks5://127.0.0.1:1080
